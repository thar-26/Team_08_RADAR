# Copy this file to .env (in the same folder) and fill in what you need.
# Only GROQ_API_KEY is required. Never commit .env.

# --- Required: language models (https://console.groq.com) ---
GROQ_API_KEY=

# --- Sign-in for profile corrections (Google) ---
# AUTH_SECRET: any long random string, used to sign sessions.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Blue Science Park staff: comma-separated email addresses that may edit every profile
# and approve access requests.
RADAR_STAFF_EMAILS=
# Extra approved email domains per company, e.g. saab=saabgroup.com;techinova=techinova.com
RADAR_COMPANY_DOMAINS=

# --- Official company facts from Bolagsverket (optional) ---
BOLAGSVERKET_CLIENT_ID=
BOLAGSVERKET_CLIENT_SECRET=
# prod, or test for Bolagsverket's test environment
BOLAGSVERKET_ENV=prod

# --- Email alerts (optional; without these, emails are previews in Radar) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM=
RADAR_APP_URL=http://localhost:3000
# For rehearsals: only these addresses get real email, everyone else gets a preview.
RADAR_MAIL_ALLOWLIST=
# Send digests automatically while the API runs (1 = on)
RADAR_SCHEDULER=
RADAR_SCHEDULER_MINUTES=60

# --- Optional ---
# Postgres instead of the local SQLite file, e.g. postgresql://user:pass@localhost:5432/radar
DATABASE_URL=
# Freeze "today" for a demo, e.g. 2026-11-14
RADAR_TODAY=
# Where the website finds the API (default http://localhost:8000)
NEXT_PUBLIC_API_URL=
